# Runtime state and secrets (generated on first run)
zen-router/settings.json
zen-router/settings.json.bak-*
zen-router/lanes.json
zen-router/burned.json
zen-router/*.tmp
zen-router/*.log
config/settings.json

# Stray runtime copies written when the relay is started from the repo root
# (they carry the relay key and the Webshare token, exactly like the above).
/settings.json
/lanes.json
/burned.json
/settings.json.bak-*

# Stack runtime
stack/node_modules/
stack/stack.log
stack/*.log
*.log

# Build/cache artifacts
**/target/
**/.venv/
**/__pycache__/

# REST relay runtime state (holds proxy creds)
zen-router/rest/lanes.json
zen-router/rest/burned.json
zen-router/rest/settings.json
zen-router/rest/*.tmp
